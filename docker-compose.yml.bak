services:
  app:
    image: serversideup/php:8.2-cli
    container_name: crm_l10_app
    working_dir: /var/www
    volumes:
      - .:/var/www
    ports:
      - "8010:8010"
    command: php -S 0.0.0.0:8010 -t public
    depends_on:
      - redis
      - mysql

  redis:
    image: redis:7-alpine
    container_name: crm_l10_redis
    ports:
      - "6380:6379"
    volumes:
      - crm_l10_redis:/data

  mysql:
    image: mysql:8.0
    container_name: crm_l10_mysql
    ports:
      - "3308:3306"
    environment:
      MYSQL_ROOT_PASSWORD: ""
      MYSQL_ALLOW_EMPTY_PASSWORD: "yes"
      MYSQL_DATABASE: crm_l10
    volumes:
      - crm_l10_mysql:/var/lib/mysql

volumes:
  crm_l10_redis:
  crm_l10_mysql:
